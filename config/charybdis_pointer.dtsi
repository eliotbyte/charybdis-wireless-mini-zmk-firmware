#include <input/processors.dtsi>
#include <dt-bindings/zmk/input_transform.h>

/ {
    pointer_auto_layer: pointer_auto_layer {
        compatible = "zmk,input-processor-temp-layer";
        #input-processor-cells = <2>;
        require-prior-idle-ms = <150>;
    };
};

&trackball_listener {
    /* base processor chain on all layers */
    input-processors = <
        &pointer_auto_layer 5 850
        &zip_xy_scaler 5 5
    >;

    /* layer 9 (SCROLL): ring hold — trackball → scroll, divisor 8 */
    scroll_mode {
        layers = <9>;
        input-processors = <&zip_xy_to_scroll_mapper &zip_scroll_scaler 1 8>;
    };

    /* layer 10 (PRECISION): pinky hold — slow cursor, divisor 3 */
    precision_mode {
        layers = <10>;
        input-processors = <&pointer_auto_layer 5 850 &zip_xy_scaler 1 3>;
    };
};